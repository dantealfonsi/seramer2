{
  "sql": "SELECT cr.report_id, mk.stall_number AS puesto, mk.location_description AS local, ifr.infraction_description, aw.first_name, aw.last_name, aw.id_number AS cedula, aw.phone, cr.citation_id, cr.awardee_attendance, cr.result, cr.agreement_details, DATE(cr.report_date) AS report_date_only, TIME(cr.report_date) AS report_time_only, cr.report_date, c.infraction_id, c.citation_datetime, c.location, c.mediator_user_id, c.citation_status FROM conciliation_reports cr INNER JOIN citations c ON cr.citation_id = c.citation_id INNER JOIN infractions ifr ON ifr.infraction_id = c.infraction_id INNER JOIN awardees aw ON aw.id = ifr.awardee_id INNER JOIN market_stalls mk ON mk.id = ifr.stall_id WHERE  cr.citation_id = :id",
 "fields": [
    "first_name",
    "infraction_description",
    "puesto",
    "local",
    "last_name",
    "cedula",
    "phone",
    "report_id",
    "citation_id",
    "awardee_attendance",
    "result",
    "agreement_details",
    "report_date_only",   
    "report_time_only",
    "report_date",
    "infraction_id",
    "citation_datetime",
    "location",
    "mediator_user_id",
    "citation_status"
]
}