<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Infracción #{{infraction_id}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.4;
            color: #333;
            padding: 20px;
        }
        
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            border: 2px solid #333;
            padding: 20px;
        }
        
        /* HEADER SECTION */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #333;
        }
        
        .header-left {
            flex: 0 0 200px;
        }
        
        .logo {
            width: 120px;
            height: auto;
            margin-bottom: 10px;
        }
        
        .company-name {
            font-size: 11px;
            font-weight: bold;
            line-height: 1.3;
        }
        
        .header-center {
            flex: 1;
            padding: 0 20px;
            text-align: center;
        }
        
        .address-title {
            font-weight: bold;
            font-size: 11px;
            margin-bottom: 5px;
        }
        
        .address-details {
            font-size: 10px;
            line-height: 1.4;
        }
        
        .header-right {
            flex: 0 0 180px;
            text-align: right;
        }
        
        .infraction-number {
            font-size: 11px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .infraction-id {
            font-size: 32px;
            font-weight: bold;
            color: #d32f2f;
        }
        
        .infraction-date {
            font-size: 10px;
            margin-top: 5px;
        }
        
        /* BUSINESS INFO SECTION */
        .business-info {
            margin: 20px 0;
            padding: 15px;
            background-color: #f5f5f5;
        }
        
        .info-row {
            margin-bottom: 8px;
        }
        
        .info-label {
            font-weight: bold;
            display: inline-block;
            width: 150px;
        }
        
        .business-name-large {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 10px;
        }
        
        .rif-phone {
            display: flex;
            gap: 30px;
            margin-top: 8px;
        }
        
        /* SEPARATOR */
        .separator {
            border-top: 2px solid #333;
            margin: 20px 0;
        }
        
        /* INFRACTION DETAILS */
        .infraction-details {
            margin: 20px 0;
        }
        
        .section-title {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 15px;
            padding-bottom: 5px;
            border-bottom: 1px solid #666;
        }
        
        .detail-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        .detail-table th {
            background-color: #e0e0e0;
            padding: 10px;
            text-align: left;
            font-weight: bold;
            border: 1px solid #999;
        }
        
        .detail-table td {
            padding: 10px;
            border: 1px solid #ccc;
        }
        
        .detail-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        
        /* TOTALS */
        .totals {
            margin-top: 30px;
            float: right;
            width: 350px;
        }
        
        .totals-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 10px;
            border-bottom: 1px solid #ccc;
        }
        
        .totals-row.total {
            background-color: #e0e0e0;
            font-weight: bold;
            font-size: 14px;
            border: 2px solid #333;
            margin-top: 5px;
        }
        
        .amount {
            text-align: right;
            font-weight: bold;
        }
        
        /* FOOTER */
        .footer {
            clear: both;
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #ccc;
            font-size: 10px;
            text-align: center;
            font-style: italic;
        }
        
        .observations {
            margin: 20px 0;
            padding: 15px;
            background-color: #fff8e1;
            border-left: 4px solid #ff9800;
        }
        
        .observations-title {
            font-weight: bold;
            margin-bottom: 8px;
        }
        
        @media print {
            body {
                padding: 0;
            }
            
            .invoice-container {
                border: none;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- HEADER -->
        <div class="header">
            <div class="header-left">
                <img src="../../public/assets/img/logo.png" alt="Logo SERAMER" class="logo">
                <div class="company-name">
                    Servicio Autónomo de Mercados de Bermúdez
                </div>
            </div>
            
            <div class="header-center">
                <div class="address-title">DOMICILIO FISCAL</div>
                <div class="address-details">
                    Carúpano, Estado Sucre<br>
                    Municipio Bermúdez<br>
                    Parroquia Santa Catalina<br>
                    Calle El Mercadito
                </div>
            </div>
            
            <div class="header-right">
                <div class="infraction-number">INFRACCIÓN N°:</div>
                <div class="infraction-id">{{infraction_id}}</div>
                <div class="infraction-date">
                    Fecha: {{infraction_datetime}}
                </div>
            </div>
        </div>
        
        <!-- BUSINESS INFORMATION -->
        <div class="business-info">
            <div class="business-name-large">
                {{business_name}}
            </div>
            
            <div class="info-row">
                <span class="info-label">PUESTO:</span>
                <span>{{stall_number}}</span>
            </div>
            
            <div class="info-row">
                <span class="info-label">DIRECCIÓN:</span>
                <span>{{address}}</span>
            </div>
            
            <div class="rif-phone">
                <div>
                    <span class="info-label">RIF:</span>
                    <span>{{rif}}</span>
                </div>
                <div>
                    <span class="info-label">TELÉFONO:</span>
                    <span>{{phone}}</span>
                </div>
            </div>
            
            <div class="info-row">
                <span class="info-label">ADJUDICATARIO:</span>
                <span>{{adjudicatory_name}}</span>
            </div>
        </div>
        
        <!-- SEPARATOR -->
        <div class="separator"></div>
        
        <!-- INFRACTION DETAILS -->
        <div class="infraction-details">
            <div class="section-title">DETALLES DE LA INFRACCIÓN</div>
            
            <table class="detail-table">
                <thead>
                    <tr>
                        <th>TIPO DE INFRACCIÓN</th>
                        <th>DESCRIPCIÓN</th>
                        <th>SEVERIDAD</th>
                        <th>MONTO</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{infraction_type_name}}</td>
                        <td>{{infraction_description}}</td>
                        <td>{{severity_name}}</td>
                        <td class="amount">Bs. {{fine_amount}}</td>
                    </tr>
                </tbody>
            </table>
            
            <!-- OBSERVATIONS (if any) -->
            {{#inspector_observations}}
            <div class="observations">
                <div class="observations-title">OBSERVACIONES DEL INSPECTOR:</div>
                <div>{{inspector_observations}}</div>
            </div>
            {{/inspector_observations}}
        </div>
        
        <!-- TOTALS -->
        <div class="totals">
            <div class="totals-row">
                <span>MONTO BASE:</span>
                <span class="amount">Bs. {{fine_amount}}</span>
            </div>
            
            <div class="totals-row total">
                <span>TOTAL A PAGAR:</span>
                <span class="amount">Bs. {{fine_amount}}</span>
            </div>
        </div>
        
        <!-- FOOTER -->
        <div class="footer">
            <p>Este documento constituye notificación oficial de la infracción cometida.</p>
            <p>El pago debe realizarse en un plazo de 30 días hábiles desde la fecha de emisión.</p>
            <p>Estado de la Sanción: <strong>{{sanction_status}}</strong></p>
        </div>
    </div>
</body>
</html>
