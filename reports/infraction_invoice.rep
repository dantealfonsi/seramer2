<!-- HTML_REPORT -->
<style>
    /* Estilos del reporte de infracción */
    .invoice-wrapper {
        max-width: 8.5in;
        margin: 0 auto;
        background-color: #fff;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
        border-radius: 4px;
    }
    
    .invoice-container {
        padding: 0.4in;
        min-height: 10in;
        background-color: #fff;
    }
    
    .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid #333;
    }
    
    .company-name {
        font-size: 10px;
        font-weight: bold;
        line-height: 1.2;
    }
    
    .header-center {
        flex: 1;
        padding: 0 15px;
        text-align: center;
    }
    
    .address-title {
        font-weight: bold;
        font-size: 11px;
    }
    
    .address-details {
        font-size: 10px;
    }
    
    .infraction-id {
        font-size: 28px;
        font-weight: bold;
        color: #d32f2f;
    }
    
    .business-info {
        margin: 20px 0;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 8px;
    }
    
    .info-row {
        margin-bottom: 8px;
        display: flex;
    }
    
    .info-label {
        font-weight: bold;
        min-width: 130px;
    }
    
    .business-name-large {
        font-size: 15px;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 12px;
    }
    
    .section-title {
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 12px;
        padding-bottom: 6px;
        border-bottom: 2px solid #333;
    }
    
    .detail-table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .detail-table th, .detail-table td {
        padding: 10px;
        border: 1px solid #ddd;
        font-size: 11px;
    }
    
    .detail-table th {
        background-color: #f1f1f1;
    }
    
    .totals {
        margin-top: 25px;
        float: right;
        width: 300px;
    }
    
    .totals-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px;
        border-bottom: 1px solid #eee;
    }
    
    .totals-row.total {
        background-color: #333;
        color: #fff;
        font-weight: bold;
        border-radius: 4px;
        margin-top: 8px;
    }

    @media print {
        .invoice-wrapper {
            box-shadow: none !important;
            margin: 0 !important;
            max-width: 100% !important;
        }
        .invoice-container {
            padding: 0.3in !important;
        }
    }
</style>

<div class="invoice-wrapper">
    <div class="invoice-container">
        <!-- HEADER -->
        <div class="header">
            <div class="header-left">
                <div class="company-name">
                    REPÚBLICA BOLIVARIANA DE VENEZUELA<br>
                    ALCALDÍA DEL MUNICIPIO BERMÚDEZ<br>
                    SERAMER
                </div>
            </div>
            <div class="header-center">
                <div class="address-title">SERVICIO AUTÓNOMO DE MERCADOS MUNICIPALES</div>
                <div class="address-details">
                    Carúpano, Estado Sucre<br>
                    RIF: G-20000000-0
                </div>
            </div>
            <div class="header-right">
                <div class="infraction-number">INFRACCIÓN Nº</div>
                <div class="infraction-id">{{infraction_id}}</div>
            </div>
        </div>

        <div class="business-info">
            <div class="business-name-large">{{business_name}}</div>
            <div class="info-row">
                <span class="info-label">RIF:</span>
                <span>{{rif}}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Adjudicatario:</span>
                <span>{{adjudicatory_name}}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Puesto:</span>
                <span>{{stall_number}}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Ubicación:</span>
                <span>{{address}}</span>
            </div>
        </div>

        <div class="infraction-details">
            <div class="section-title">DETALLES DE LA INFRACCIÓN</div>
            <table class="detail-table">
                <thead>
                    <tr>
                        <th>Concepto / Tipo de Infracción</th>
                        <th>Fecha y Hora</th>
                        <th>Gravedad</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{infraction_type_name}}</td>
                        <td>{{infraction_datetime}}</td>
                        <td>{{severity_name}}</td>
                        <td>{{sanction_status}}</td>
                    </tr>
                </tbody>
            </table>
            
            <div style="margin-top: 20px;">
                <div class="section-title">DESCRIPCIÓN Y OBSERVACIONES</div>
                <div style="padding: 10px; border: 1px solid #ddd; font-size: 11px; min-height: 80px;">
                    <strong>Hechos:</strong> {{infraction_description}}<br><br>
                    <strong>Observaciones:</strong> {{inspector_observations}}
                </div>
            </div>
        </div>

        <div class="totals text-end">
            <div class="totals-row">
                <span>Monto de la Multa (UT/Petros)</span>
                <span class="amount">{{fine_amount}}</span>
            </div>
            <div class="totals-row total">
                <span>TOTAL A PAGAR</span>
                <span class="amount">{{fine_amount}}</span>
            </div>
        </div>
        
        <div style="clear: both; margin-top: 100px; display: flex; justify-content: space-around;">
            <div style="border-top: 1px solid #000; width: 200px; text-align: center; padding-top: 5px; font-size: 10px;">
                FIRMA DEL FISCAL
            </div>
            <div style="border-top: 1px solid #000; width: 200px; text-align: center; padding-top: 5px; font-size: 10px;">
                FIRMA DEL ADJUDICATARIO
            </div>
        </div>
    </div>
</div>
